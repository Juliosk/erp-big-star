# Development-only defaults. Copy this file to .env and rotate every value
# before using a shared environment.
COMPOSE_PROJECT_NAME=bigstar_erp

APP_NAME=ERP Big Star / Forma Kids
APP_VERSION=0.1.0
ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO
READINESS_DATABASE_TIMEOUT_SECONDS=2

# Explicit opt-in for local/test only; never enable in staging/production.
# Fill token (32-256 ASCII characters), actor UUID and existing company UUIDs before enabling.
DEV_AUTH_ENABLED=false
DEV_AUTH_TOKEN=
DEV_AUTH_COMPANY_IDS=[]
# DEV_AUTH_ACTOR_ID=<uuid>
# DEV_AUTH_PERMISSIONS=["admin.company.read","product.product.read"]

POSTGRES_HOST=127.0.0.1
POSTGRES_DB=erp_oltp
POSTGRES_USER=erp_app
POSTGRES_PASSWORD=local_only_change_me_postgres
POSTGRES_PORT=5432
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

RABBITMQ_DEFAULT_USER=erp_app
RABBITMQ_DEFAULT_PASS=local_only_change_me_rabbitmq
RABBITMQ_HOST=127.0.0.1
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_VIRTUAL_HOST=/
RABBITMQ_CONNECTION_TIMEOUT_SECONDS=5
RABBITMQ_PREFETCH_COUNT=20
RABBITMQ_EVENTS_EXCHANGE=erp.events
RABBITMQ_REQUESTS_EXCHANGE=erp.requests
RABBITMQ_RETRY_EXCHANGE=erp.retry
RABBITMQ_DEAD_LETTER_EXCHANGE=erp.dlx
RABBITMQ_RETRY_DELAYS_MS=[30000,120000,300000,900000]

IDEMPOTENCY_TTL_SECONDS=86400

REDIS_PASSWORD=local_only_change_me_redis
REDIS_PORT=6379

MINIO_ROOT_USER=erp_app
MINIO_ROOT_PASSWORD=local_only_change_me_minio_12345
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Provision this private bucket before uploads. Use a bucket-scoped service account.
IMPORT_STORAGE_ENDPOINT=127.0.0.1:9000
IMPORT_STORAGE_BUCKET=erp-imports
IMPORT_STORAGE_ACCESS_KEY=
IMPORT_STORAGE_SECRET_KEY=
IMPORT_STORAGE_SECURE=false
