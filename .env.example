# Development-only defaults. Copy this file to .env and rotate every value
# before using a shared environment.
COMPOSE_PROJECT_NAME=bigstar_erp

POSTGRES_DB=erp_oltp
POSTGRES_USER=erp_app
POSTGRES_PASSWORD=local_only_change_me_postgres
POSTGRES_PORT=5432

RABBITMQ_DEFAULT_USER=erp_app
RABBITMQ_DEFAULT_PASS=local_only_change_me_rabbitmq
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

REDIS_PASSWORD=local_only_change_me_redis
REDIS_PORT=6379

MINIO_ROOT_USER=erp_app
MINIO_ROOT_PASSWORD=local_only_change_me_minio_12345
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

